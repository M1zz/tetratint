/* Color vision screen */
"Color vision simulation" = "Farvesynssimulering";
"This shows how your colors look to people with color vision deficiency. It is the current state, not a suggestion to change them." = "Her ser du, hvordan dine farver tager sig ud for personer med nedsat farvesyn. Det er den nuværende status og ikke et forslag om at ændre dem.";
