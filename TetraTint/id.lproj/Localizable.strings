/* Color vision screen */
"Color vision simulation" = "Simulasi penglihatan warna";
"This shows how your colors look to people with color vision deficiency. It is the current state, not a suggestion to change them." = "Ini menunjukkan tampilan warna Anda bagi penderita gangguan penglihatan warna. Ini kondisi saat ini, bukan saran untuk mengubahnya.";
"Conflict warnings" = "Peringatan warna sulit dibedakan";
"Finds color pairs that become too similar to tell apart under simulation." = "Menemukan pasangan warna yang jadi terlalu mirip untuk dibedakan saat disimulasikan.";
"Recommended safe palettes" = "Palet aman buta warna";
"If there were conflicts above, switch to a verified palette that stays distinguishable across every vision type." = "Jika ada konflik di atas, ganti dengan palet terverifikasi yang tetap mudah dibedakan di semua jenis penglihatan.";
"No palette saved yet, so the Okabe Ito demo palette is shown. Save colors in Generator to audit your own palette." = "Belum ada palet tersimpan, jadi palet demo Okabe Ito ditampilkan. Simpan warna di Generator untuk memeriksa palet Anda sendiri.";
"Color" = "Warna";
"All color pairs stay distinguishable across every vision type (ΔE ≥ 12)" = "Semua pasangan warna tetap bisa dibedakan di semua jenis penglihatan (ΔE ≥ 12)";
"ΔE %@ under %@" = "ΔE %1$@ pada %2$@";
"Do not rely on color alone. Pair it with icons, patterns, or labels, or switch to a safe palette below." = "Jangan mengandalkan warna saja. Padukan dengan ikon, pola, atau label, atau ganti ke palet aman di bawah.";
